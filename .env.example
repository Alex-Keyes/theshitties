# Leave DATABASE_URL empty to use embedded Postgres in .local (development only).
# For Neon, use a dedicated development branch connection string.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with npm run admin:password -- 'your long password'
ADMIN_PASSWORD_HASH=
# Enable only in a dedicated development database, never production.
ALLOW_DEMO_SEED=false
